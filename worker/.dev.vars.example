# Copy to .dev.vars and fill with real values
# NEVER commit .dev.vars — it's in .gitignore

DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI=http://localhost:5173/dropbox-callback
GEMINI_API_KEY=your_gemini_api_key_here
# Optional second account — used automatically if the first hits quota/429
GEMINI_API_KEY_2=your_second_gemini_api_key_here
JWT_SECRET=dev-secret-change-me-in-prod-min-32-chars
# After first family setup, paste the refresh token shown in the UI:
# FAMILY_DROPBOX_REFRESH_TOKEN=
